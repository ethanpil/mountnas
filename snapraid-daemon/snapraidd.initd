#!/sbin/openrc-run
# snapraidd — SnapRAID Daemon: scheduler, REST API and web UI for SnapRAID.
# OFF by default; 'nas snapraid on' is the opt-in switch (same pattern as
# 'nas web' and 'nas ttyd').
#
# The daemon daemonizes itself and writes $pidfile, so this script does not
# use command_background: start-stop-daemon starts it and the daemon forks.
#
# Upstream ships a systemd unit and a BSD-style rc script only. This script
# carries the parts of that unit that matter on OpenRC:
#   - after localmount + net   (parity and data disks must be mounted, and
#                               the API binds an address)
#   - nice 19 / ionice idle    (Nice=19, IOSchedulingClass=idle — SnapRAID is
#                               I/O heavy and must not lag the box)
#   - reload = SIGHUP          (ExecReload=kill -HUP)
# It runs as root, as upstream requires: the snapraid child it spawns needs
# block-level access to the parity and data disks.
#
# NOT carried over: Restart=on-failure. OpenRC can supervise a foreground
# daemon (snapraidd -f) with supervise-daemon, but no service in MountNAS is
# supervised, so this one matches the rest of the box. A daemon that dies
# shows as "enabled but not running" in 'nas snapraid status' and on the
# dashboard.
description="SnapRAID Daemon (scheduler, REST API, web UI)"
description_reload="Re-read /etc/snapraidd.conf without stopping the daemon"

CONF=/etc/snapraidd.conf
DEFAULT_CONF=/usr/share/snapraidd/snapraidd.conf.default

command="/usr/bin/snapraidd"
command_args="--conf $CONF"
pidfile="/run/snapraidd.pid"
# SnapRAID is I/O heavy; keep it off the critical path of everything else.
start_stop_daemon_args="--nicelevel 19 --ionice 3"
extra_started_commands="reload"

depend() {
	# mountnas mounts the data/parity disks; the daemon reads the array
	# through the snapraid CLI, so it must not start before they are there.
	need localmount
	after net mountnas
	use logger
}

start_pre() {
	# The apkovl seed only reaches a FRESHLY FLASHED box. A box that upgraded
	# into this package has no /etc/snapraidd.conf, so copy the packaged
	# default once. (The daemon rewrites its own config, so this file is
	# user-owned from here on and 'nas commit' persists it.)
	if [ ! -f "$CONF" ] && [ -f "$DEFAULT_CONF" ]; then
		cp "$DEFAULT_CONF" "$CONF" \
			&& einfo "seeded $CONF from the packaged default — run 'nas commit' to keep it"
	fi
	if [ ! -f "$CONF" ]; then
		eerror "$CONF not found and no packaged default at $DEFAULT_CONF."
		return 1
	fi
	# The daemon keeps its record of past syncs and scrubs in the command
	# logs. On a diskless box /var/log is RAM, so the shipped config points
	# sys_log_directory at the data disk. Create it when it is missing —
	# but ONLY on a real mount: with the data disk absent, /mnt/nasdata is
	# either the RAM root or the supervisor's read-only placeholder, and
	# filling the RAM root is what the setting exists to avoid.
	_dir=$(sed -n 's/^[[:space:]]*sys_log_directory[[:space:]]*=[[:space:]]*//p' "$CONF" 2>/dev/null \
		| tail -n1 | sed 's/[[:space:]]*$//')
	# An empty value is meaningful: upstream reads it as "do not save logs".
	if [ -n "$_dir" ] && [ ! -d "$_dir" ]; then
		_up=$_dir
		while [ "$_up" != "/" ] && ! mountpoint -q "$_up" 2>/dev/null; do
			_up=$(dirname "$_up")
		done
		if [ "$_up" = "/" ]; then
			ewarn "$_dir is not on a mounted disk — not creating it."
			ewarn "The task history would fill the RAM root. Mount the data disk,"
			ewarn "or point sys_log_directory in $CONF somewhere that is mounted."
		elif ! mkdir -p "$_dir" 2>/dev/null; then
			ewarn "cannot create $_dir — the daemon loses its task history at every restart"
		fi
	fi
	return 0
}

reload() {
	ebegin "Reloading SnapRAID Daemon configuration"
	start-stop-daemon --signal HUP --pidfile "$pidfile"
	eend $?
}

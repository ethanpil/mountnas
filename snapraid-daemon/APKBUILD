# Maintainer: MountNAS <ethan@piliavin.com>
# SnapRAID-Daemon is a SEPARATE upstream project from SnapRAID itself
# (github.com/amadvance/snapraid-daemon). SnapRAID 14.x only added the logging
# and --gui-* hooks the daemon drives; the daemon is what turns SnapRAID from a
# cron-driven CLI into a scheduled service with a REST API and a web UI. It is
# in no Alpine repository, so MountNAS compiles it from source like snapraid.
#
# It runs the SAME snapraid binary underneath, so the array format, the config
# and the recovery story are unchanged — the daemon only schedules and reports.
pkgname=snapraid-daemon
pkgver=1.14
pkgrel=0
pkgdesc="Scheduler, REST API and web UI for SnapRAID (runs the snapraid CLI)"
url="https://github.com/amadvance/snapraid-daemon"
arch="all"
# COPYING: "The SnapRAID-Daemon project as a whole ... is provided under the
# GPL-3.0-or-later License", with bundled TommyDS (BSD-2-Clause) and
# CivetWeb/JSMN (MIT). LICENSES/ holds exactly those three texts.
license="GPL-3.0-or-later AND BSD-2-Clause AND MIT"
# zip packs the web UI into /usr/share/snapraidd/commander.zip during the
# build; configure FAILS without it. zlib-dev/zstd-dev are NOT optional in
# practice: configure probes for them and silently disables HTTP compression
# when they are absent, so leaving them out makes the package depend on
# whatever the builder happened to have installed.
makedepends="linux-headers zip zlib-dev zstd-dev"
# snapraid>=14.6: the daemon shells out to the CLI and needs its heartbeat
# logging (daemon 1.11 release note). The version is what makes the pairing
# safe, so declare it rather than rely on packages.list ordering.
depends="snapraid>=14.6"
options="!check"
source="snapraid-daemon-$pkgver.tar.gz::https://github.com/amadvance/snapraid-daemon/releases/download/v$pkgver/snapraid-daemon-$pkgver.tar.gz
	snapraidd.initd
	snapraidd.conf.default
	"
builddir="$srcdir/snapraid-daemon-$pkgver"

build() {
	# --with-init-type=none is NOT cosmetic: it defaults to 'auto', which
	# installs a systemd unit or a BSD rc script depending on which
	# directories exist ON THE BUILD HOST. Pinning it keeps the package
	# reproducible and guarantees our OpenRC script is the only service file.
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--with-init-type=none
	make
}

package() {
	make DESTDIR="$pkgdir" install
	# Same reason as snapraid: an appliance running from RAM does not carry man
	# pages, and abuild wants them gzipped or split into a -doc subpackage.
	rm -rf "$pkgdir"/usr/share/man
	# Ship upstream's fully commented option reference AND the MountNAS
	# default config INSIDE the apk, under /usr/share (never /etc — see
	# CONTEXT.md §3: an apk-installed /etc file is clobbered by the overlay at
	# every boot). Two jobs:
	#   .example  the only on-box reference for the ~30 config options; the
	#             man page is dropped and the box may be offline.
	#   .default  what the init script and 'nas snapraid on' copy to
	#             /etc/snapraidd.conf when it is absent. The apkovl seed only
	#             reaches a freshly flashed box, so without this the feature
	#             would be unreachable on every box that UPGRADED into it.
	install -Dm644 "$builddir"/snapraidd.conf.example \
		"$pkgdir"/usr/share/snapraidd/snapraidd.conf.example
	install -Dm644 "$srcdir"/snapraidd.conf.default \
		"$pkgdir"/usr/share/snapraidd/snapraidd.conf.default
	# The init script is code, so it ships in the apk like zerotier-one's.
	# There is deliberately NO /etc/conf.d file: every setting the daemon has
	# lives in its own /etc/snapraidd.conf, and a conf.d shipped by an apk
	# would be the one editable /etc file in this repo that the overlay
	# clobbers and 'nas upgrade' can never refresh.
	install -Dm755 "$srcdir"/snapraidd.initd "$pkgdir"/etc/init.d/snapraidd
}

# Committed (NOT regenerated in CI) so the pinned release is integrity-checked:
# if the GitHub asset is ever replaced, the build fails instead of shipping it.
# On a pkgver bump, refresh with: abuild checksum
sha512sums="

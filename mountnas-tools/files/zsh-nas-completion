#compdef nas
# zsh completion for the nas CLI (installed to /usr/share/zsh/site-functions/_nas,
# which is in zsh's default fpath — active for users running compinit).
# Command list: keep in sync with the dispatcher in files/nas AND the bash
# completion (files/bash-nas-completion.sh).
local -a cmds
cmds=(setup status disks disk mount restart changes changed commit save rollback backup logs log web ttyd snapraid share shares history notify report shutdown reboot upgrade version about help)
if (( CURRENT == 2 )); then
	_describe "nas command" cmds
elif [[ $words[CURRENT-1] == --persist ]]; then
	_values state on off status
elif [[ $words[CURRENT-1] == --to ]]; then
	_files -/
else
	case "$words[2]" in
		status)          _values flag --deep --json ;;
		disks|disk)      _values flag --json init ;;
		changes|changed) _values flag --diff ;;
		commit|save)     _values flag -m ;;
		rollback)        _values flag --list ;;
		backup)          _values flag --to ;;
		logs|log)        _values flag -f -n --persist ;;
		web|ttyd)        _values action on off status ;;
		snapraid)        _values action run add schedule status ;;
		share|shares)    _values action list add remove delete allow revoke user users ;;
		history)         _values flag -n --all ;;
		notify)          _values flag --test ;;
		upgrade)         _alternative "flags:flag:(--check --yes)" "files:image:_files" ;;
		reboot|shutdown) _values flag --yes --save ;;
		help)            _describe "help topic" cmds ;;
	esac
fi

#!/bin/sh
# nas — MountNAS control CLI (dispatcher)
#
# The code lives in /usr/libexec/mountnas: lib.sh holds the shared state
# and helpers, cmd/<name>.sh holds one command each (its cmd_* function
# and its help_* page). Every file is sourced here at start, NOT on
# demand: a running command must never load a sibling file that apk
# replaced after this process began. That window is real — between
# 'nas upgrade' and the reboot, an 'apk add' re-solves the new world and
# can pull the new mountnas-tools into the RAM root while an old 'nas' is
# still running. Parsing everything up front costs milliseconds.
set -u
NAS_LIB=/usr/libexec/mountnas
. "$NAS_LIB/lib.sh"
# shellcheck disable=SC1090  # the cmd files are linted on their own (ci-lint)
for _f in "$NAS_LIB"/cmd/*.sh; do . "$_f"; done
unset _f

# Per-command help: 'nas <cmd> --help' or 'nas help <cmd>'. Each page is a
# help_<cmd> function next to its command in cmd/<name>.sh; this maps the
# command names and aliases onto them.
_cmd_help_for() {
	case "${1:-}" in
	status) help_status ;;
	disks) help_disks ;;
	changes|changed) help_changes ;;
	rollback) help_rollback ;;
	backup) help_backup ;;
	logs|log) help_logs ;;
	upgrade) help_upgrade ;;
	shutdown|reboot) help_shutdown "$1" ;;
	setup) help_setup ;;
	version) help_version ;;
	about) help_about ;;
	commit|save) help_commit ;;
	restart) help_restart ;;
	report) help_report ;;
	web) help_web ;;
	ttyd) help_ttyd ;;
	history) help_history ;;
	notify) help_notify ;;
	*) return 1 ;;
	esac
	# 0 for every known topic, as before the split: the status of the
	# page itself (a failed write to a closed stdout) must not read as
	# 'no such topic' and print the overview on top of the failure.
	return 0
}

# 'nas <cmd> --help' NEVER executes the command: focused help when we have a
# page for it, the overview otherwise. (Falling through used to RUN the
# command — 'nas status --help' would have run a status instead of helping.)
case "${2:-}" in
	--help|-h) _cmd_help_for "${1:-}" || cmd_help; exit 0 ;;
esac

case "${1:-help}" in
	setup) cmd_setup ;;
	# one order-independent flag parser: --json/--deep combine in any order
	# (positional matching used to silently drop one of them, and
	# 'nas status --json' must never emit human text into a monitoring pipe).
	status)
		shift
		js=0; dp=0
		for a in "$@"; do
			case "$a" in
				--json) js=1 ;;
				--deep) dp=1 ;;
				*) usage "nas status [--deep] [--json]"; exit 1 ;;
			esac
		done
		if [ "$js" = 1 ]; then
			if [ "$dp" = 1 ]; then cmd_status_json --deep; else cmd_status_json; fi
		else
			if [ "$dp" = 1 ]; then cmd_status --deep; else cmd_status; fi
		fi
		;;
	disks) shift
		case "${1:-}" in
			--json) cmd_disks_json ;;
			*) cmd_disks ;;
		esac ;;
	restart) cmd_restart ;;
	changes|changed) shift; cmd_changes "$@" ;;
	report) cmd_report ;;
	commit|save) shift; cmd_commit "$@" ;;
	rollback) shift; cmd_rollback "$@" ;;
	logs|log) shift; cmd_logs "$@" ;;
	web) shift; cmd_web "$@" ;;
	ttyd) shift; cmd_ttyd "$@" ;;
	history) shift; cmd_history "$@" ;;
	notify) shift; cmd_notify "$@" ;;
	backup) shift; cmd_backup "$@" ;;
	shutdown) shift; cmd_shutdown "$@" ;;
	reboot) shift; cmd_reboot "$@" ;;
	upgrade) shift; cmd_upgrade "$@" ;;
	version) cmd_version ;;
	about) cmd_about ;;
	help|--help|-h) shift 2>/dev/null || true
		if [ -n "${1:-}" ]; then
			# a typo'd topic must not look like success (matches the
			# unknown-command behavior of the dispatcher below). Print the
			# command list only (_help_page1) — no pager pause on an error
			# path, which would otherwise block an interactive typo or hang
			# pty automation waiting for a keypress.
			_cmd_help_for "$1" || { echo "no help for '$1' — commands:"; echo; _help_page1; exit 1; }
		else
			cmd_help
		fi ;;
	*) echo "unknown command: $1"; echo; _help_page1; exit 1 ;;
esac
rc=$?

# Keep the prompt's [unsaved:N] indicator current after any command that may have
# changed state (e.g. commit zeroes it). Commands that exec (shutdown/reboot) never
# reach here, which is fine — the box is on its way down.
# Exit with the command's status, not _refresh_unsaved's (always 0): scripted
# callers — including the CI expect tests — must see failures.
_refresh_unsaved
exit "$rc"

#!/bin/sh
# notify — fan an alert out to every configured notification sink.
#
#   notify <subject> [body]        body falls back to stdin when piped
#   notify --list                  print the active sinks, one per line
#
# Sinks live in /etc/mountnas/notify.conf, one per line as  type:target
# (see the shipped template). No sinks configured means this is a silent
# no-op — every caller can invoke it unconditionally.
#
# Stateless by design: no daemon, nothing resident. It runs only when an
# event fires (data-watch transition, smartd trouble, failed upgrade, digest,
# 'nas notify'), sends, and exits. Every network send is bounded (--max-time)
# so a dead sink can never hang a caller like the 15-minute watcher.
# Exit: 0 when every attempted sink succeeded (or none configured), 1 otherwise.
CONF=/etc/mountnas/notify.conf
LOG=/var/log/mountnas.log
CURL="curl -fsS --max-time 10"

log() { printf '%s notify: %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }

# Active sinks = the non-comment notify.conf lines, deduped.
# Trim BOTH ends. The shipped template indents every example ('#   ntfy:...'),
# so the natural edit — delete the '#' — leaves leading spaces, and the
# delivery loop below reads with IFS= (which does NOT trim). The sink type
# then parsed as '   ntfy', every alert was dropped as an unknown type, and
# nas status still counted the line and reported alerting healthy.
_sinks() {
	sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' \
		"$CONF" 2>/dev/null | sort -u
}

# The sink types this helper can actually deliver to. A line whose type is not
# one of these is DISCARDED at delivery, so it must never be counted as a
# working sink — 'nas status' used to count raw lines, which meant a bare
# 'you@example.com' (the natural mistake now that the old single-address file
# is gone) read as "alerting healthy" while every alert went nowhere.
_is_kind() {
	case "$1" in email|ntfy|webhook|slack|discord|gotify) return 0 ;; *) return 1 ;; esac
}
_sinks_valid() { _sinks | while IFS= read -r s; do _is_kind "${s%%:*}" && printf '%s\n' "$s"; done; }
_sinks_bad()   { _sinks | while IFS= read -r s; do _is_kind "${s%%:*}" || printf '%s\n' "$s"; done; }

if [ "${1:-}" = "--list" ]; then _sinks_valid; exit 0; fi
if [ "${1:-}" = "--list-bad" ]; then _sinks_bad; exit 0; fi

[ -n "${1:-}" ] || { echo "usage: notify <subject> [body]   |   notify --list" >&2; exit 1; }
subject="$1"; shift
body="$*"
# body from stdin when not given as arguments (and stdin is not a terminal)
if [ -z "$body" ] && [ ! -t 0 ]; then body=$(cat); fi
[ -n "$body" ] || body="$subject"
# one uniform subject: every sink shows which box is talking. Strip CR/LF —
# the subject travels in an HTTP header (ntfy Title) and in mail -s, where a
# newline breaks the request outright (header injection / malformed send).
subj=$(printf '[%s] %s' "$(hostname)" "$subject" | tr -d '\r\n')

fails=0
while IFS= read -r sink; do
	[ -n "$sink" ] || continue
	kind=${sink%%:*}; target=${sink#*:}
	rc=0
	case "$kind" in
	email)
		if command -v mail >/dev/null 2>&1; then
			printf '%s\n' "$body" | mail -s "$subj" "$target" 2>>"$LOG" || rc=1
		else
			log "email sink $target skipped: mail(1) unavailable (configure msmtp)"; rc=1
		fi ;;
	ntfy)
		# body on STDIN with @-, never as an argument value: curl reads a
		# leading '@' in --data-binary as "upload this local file", so an
		# alert whose text began with '@' was dropped (and '<' would have
		# sent the contents of a local file to the sink instead).
		printf '%s' "$body" | $CURL -H "Title: $subj" --data-binary @- "$target" >/dev/null 2>>"$LOG" || rc=1 ;;
	webhook)
		jq -n --arg t "$subj" --arg m "$body" --arg h "$(hostname)" \
			'{title:$t, message:$m, host:$h}' \
			| $CURL -H 'Content-Type: application/json' --data-binary @- "$target" >/dev/null 2>>"$LOG" || rc=1 ;;
	slack)
		jq -n --arg t "$subj" --arg m "$body" '{text:("*\($t)*\n\($m)")}' \
			| $CURL -H 'Content-Type: application/json' --data-binary @- "$target" >/dev/null 2>>"$LOG" || rc=1 ;;
	discord)
		# Discord rejects messages over 2000 chars — trim the body, keep the subject
		jq -n --arg t "$subj" --arg m "$(printf '%s' "$body" | head -c 1800)" \
			'{content:("**\($t)**\n\($m)")}' \
			| $CURL -H 'Content-Type: application/json' --data-binary @- "$target" >/dev/null 2>>"$LOG" || rc=1 ;;
	gotify)
		# 'message=<-' reads the value from stdin — same reason as ntfy above:
		# in -F, a leading '@' means upload a file and '<' means read one.
		printf '%s' "$body" | $CURL -F "title=$subj" -F "message=<-" "$target" >/dev/null 2>>"$LOG" || rc=1 ;;
	*)
		log "unknown sink type '$kind' in $CONF — skipped"; rc=1 ;;
	esac
	[ "$rc" = 0 ] || { fails=$((fails + 1)); log "sink $kind:$target failed"; }
done <<EOF
$(_sinks)
EOF

[ "$fails" = 0 ] || exit 1
exit 0

#!/bin/sh
# gen-webstatus — render the read-only status dashboard into the tmpfs webroot.
#
# Design (see CONTEXT.md): NO request-time code. A root-run refresher renders
# static index.html + status.json into /run/mountnas/web every ~2 minutes and
# busybox httpd serves only those files — the attack surface is "serve static
# files", and tmpfs means zero disk writes (no drive spin-up, no flash wear).
# Everything shown comes from 'nas status --json' + 'nas disks --json' (no
# secrets by construction) plus /proc//sys/file reads — nothing here may ever
# wake a sleeping disk (SMART is -n standby + cached; power state is an
# ioctl; /cfg and /mnt/nasdata are always-awake by design) or run
# request-driven logic.
WEB=${WEB:-/run/mountnas/web}
CFG=/cfg
DATA=/mnt/nasdata
mkdir -p "$WEB"

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
hum_kb() { # KB -> human
	awk -v k="${1:-0}" 'BEGIN{ if (k>=1073741824) printf "%.1f TB", k/1073741824;
		else if (k>=1048576) printf "%.1f GB", k/1048576;
		else if (k>=1024) printf "%.0f MB", k/1024; else printf "%d KB", k }'
}

# status --json exits 1 when a check FAILs — the output is still the snapshot
# we want. Guard with jq so a hard failure degrades to an "unknown" page.
sj=$(NO_COLOR=1 nas status --json 2>/dev/null) || true
dj=$(NO_COLOR=1 nas disks --json 2>/dev/null) || true
printf '%s' "$sj" | jq -e . >/dev/null 2>&1 || sj='{}'
printf '%s' "$dj" | jq -e . >/dev/null 2>&1 || dj='{}'

# machine-readable copy for integrations (atomic swap; linked in the footer)
printf '%s\n' "$sj" > "$WEB/status.json.new" && mv "$WEB/status.json.new" "$WEB/status.json"

state=$(printf '%s' "$sj" | jq -r '
	if (.checks.fail // 0) > 0 then "fail"
	elif (.checks.warn // 0) > 0 then "warn"
	elif .healthy == true then "ok"
	else "unknown" end')
case "$state" in
	ok)      state_word="Healthy" ;;
	warn)    state_word="Warnings" ;;
	fail)    state_word="Attention" ;;
	*)       state_word="Unknown" ;;
esac

host=$(printf '%s' "$sj" | jq -r '.hostname // "mountnas" | @html')
rel=$(printf '%s' "$sj" | jq -r '.release // "?" | @html')
build=$(printf '%s' "$sj" | jq -r '.version // "?" | @html')
ips=$(printf '%s' "$sj" | jq -r '[.ips[]? | @html] | join(" &middot; ") | if . == "" then "?" else . end')
up=$(printf '%s' "$sj" | jq -r '(.uptime_seconds // 0) |
	if . >= 86400 then "\(. / 86400 | floor)d \(. % 86400 / 3600 | floor)h"
	elif . >= 3600 then "\(. / 3600 | floor)h \(. % 3600 / 60 | floor)m"
	else "\(. / 60 | floor)m" end')
datastate=$(printf '%s' "$sj" | jq -r '.data_disk // "?"')
cfgstate=$(printf '%s' "$sj" | jq -r '.config_partition // "?"')
unsaved=$(printf '%s' "$sj" | jq -r '.unsaved_changes // 0')
lastbk=$(printf '%s' "$sj" | jq -r '(.last_backup_epoch // 0) |
	if . > 0 then (. | strflocaltime("%Y-%m-%d %H:%M")) else "never" end' 2>/dev/null || echo "never")
gen_at=$(date '+%Y-%m-%d %H:%M:%S')

# ---- cheap /proc//sys data points -------------------------------------------
loadavg=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo "?")
cores=$(nproc 2>/dev/null || echo "?")
mem=$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2}
	END{ if (t>0) printf "%.1f used &middot; %.1f avail &middot; %.1f GB total", (t-a)/1048576, a/1048576, t/1048576; else print "?" }' /proc/meminfo 2>/dev/null)
# swap row: zram holds this box's cold pages, so a filling swap is the earliest
# visible sign of memory pressure — the card showed no trace of it before
swap_row=$(awk '/^SwapTotal:/{t=$2} /^SwapFree:/{f=$2}
	END{ if (t>0) printf "<dt>Swap</dt><dd class=\"num\">%.0f used &middot; %.0f MB total</dd>", (t-f)/1024, t/1024 }' /proc/meminfo 2>/dev/null)
# RAM root fill matters on a diskless box: a full / breaks 'nas commit'
ramroot=$(df -k / 2>/dev/null | awk 'NR==2{printf "%d%% of %.1f GB", $3*100/$2, $2/1048576}')
ramroot_pct=$(df -k / 2>/dev/null | awk 'NR==2{printf "%d", $3*100/$2}')
if [ "${ramroot_pct:-0}" -ge 80 ] 2>/dev/null; then
	ramroot_html="<span class=\"pill p-warn\">$ramroot</span>"
else
	ramroot_html="<span class=\"num\">$ramroot</span>"
fi
kern="$(uname -r 2>/dev/null || echo '?') &middot; Alpine $(cat /etc/alpine-release 2>/dev/null || echo '?')"
cputemp="-"
for h in /sys/class/hwmon/hwmon*; do
	[ -f "$h/name" ] || continue
	case "$(cat "$h/name" 2>/dev/null)" in
	coretemp|k10temp|zenpower|cpu_thermal|soc_thermal|acpitz)
		t=$(cat "$h/temp1_input" 2>/dev/null) || continue
		case "$t" in *[!0-9]*|'') continue ;; esac
		cputemp="$((t / 1000))&deg;C"; break ;;
	esac
done
# fan RPMs from any hwmon that exposes them (row omitted when none)
fans=""
for f in /sys/class/hwmon/hwmon*/fan*_input; do
	[ -f "$f" ] || continue
	r=$(cat "$f" 2>/dev/null)
	case "$r" in ''|*[!0-9]*|0) continue ;; esac
	fans="$fans${fans:+ &middot; }$r rpm"
done
fans_row=""
[ -n "$fans" ] && fans_row="<dt>Fans</dt><dd class=\"num\">$fans</dd>"
procs=$(find /proc -maxdepth 1 -name '[0-9]*' 2>/dev/null | grep -c .)
logins=$(who 2>/dev/null | wc -l | tr -d ' ')
lastcommit=$(date -r "$CFG/$(hostname).apkovl.tar.gz" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "never")
# grep -c always prints a count — no || fallback (it would emit a SECOND
# line on the no-match exit-1 path and make $sinks non-numeric)
sinks=$(/usr/libexec/mountnas/notify --list 2>/dev/null | grep -c .)
if [ "${sinks:-0}" -gt 0 ] 2>/dev/null; then
	sinks_html="<span class=\"pill p-ok\">$sinks destination(s) configured</span>"
else
	sinks_html="<span class=\"pill p-off\">none &mdash; set up: nas notify</span>"
fi
# rollback points: the dated overlay snapshots next to the active one — each
# is a config state 'nas rollback' can return to (metadata reads on /cfg only)
rbk_n=$(find "$CFG" -maxdepth 1 -name '*.tar.gz' ! -name '*.apkovl.tar.gz' 2>/dev/null | wc -l | tr -d ' ')
if [ "${rbk_n:-0}" -gt 0 ] 2>/dev/null; then
	rbk_html="<span class=\"num\">$rbk_n snapshot(s) <span class=\"mut\">&middot; nas rollback</span></span>"
else
	rbk_html='<span class="mut">none yet — each commit adds one</span>'
fi
# UPS battery via NUT (upsd answers on loopback; bounded so a wedged upsd
# cannot stall the render). No UPS configured is the common case — say so.
ups_html='<span class="mut">no UPS configured (NUT ships; see the guide)</span>'
ups_name=$(sed -n 's/^\[\(.*\)\]$/\1/p' /etc/nut/ups.conf 2>/dev/null | head -n1)
if [ -n "$ups_name" ]; then
	ups_chg=$(timeout 3 upsc "$ups_name" battery.charge 2>/dev/null)
	ups_st=$(timeout 3 upsc "$ups_name" ups.status 2>/dev/null)
	case "$ups_chg" in
		''|*[!0-9]*) ups_html='<span class="pill p-warn">configured, not answering</span>' ;;
		*) if [ "$ups_chg" -ge 50 ]; then ups_html="<span class=\"pill p-ok\">${ups_chg}% &middot; $(printf '%s' "${ups_st:-?}" | esc)</span>"
		   else ups_html="<span class=\"pill p-warn\">${ups_chg}% &middot; $(printf '%s' "${ups_st:-?}" | esc)</span>"; fi ;;
	esac
fi
# last console/SSH login: wtmp history when it exists (persistent-log boxes),
# else the newest CURRENT session from utmp (who) — on a RAM-log box there is
# no login history, but whoever is logged in right now is still an answer.
lastlog_line=$(last 2>/dev/null | awk 'NF>=7 && $1!="wtmp" {print; exit}')
if [ -n "$lastlog_line" ]; then
	lu_u=$(printf '%s' "$lastlog_line" | awk '{print $1}' | esc)
	lu_t=$(printf '%s' "$lastlog_line" | awk '{for(i=4;i<=NF;i++) printf "%s%s", (i>4?" ":""), $i}' | esc)
	lastuser_html="$lu_u <span class=\"mut\">$lu_t</span>"
elif [ -n "$(who 2>/dev/null)" ]; then
	lu_u=$(who 2>/dev/null | tail -n1 | awk '{print $1}' | esc)
	lu_t=$(who 2>/dev/null | tail -n1 | awk '{for(i=3;i<=NF;i++) printf "%s%s", (i>3?" ":""), $i}' | esc)
	lastuser_html="$lu_u <span class=\"mut\">on now &middot; since $lu_t</span>"
else
	lastuser_html='<span class="mut">none recorded</span>'
fi
# root password age (shadow field 3 = days-since-epoch of the last change)
pw_hash=$(awk -F: '$1=="root"{print $2}' /etc/shadow 2>/dev/null)
pw_day=$(awk -F: '$1=="root"{print $3}' /etc/shadow 2>/dev/null)
case "$pw_hash" in
	''|'!'|'*') pwage_html='<span class="pill p-warn">NO password set — run: nas setup</span>' ;;
	*)	if [ -n "$pw_day" ] && [ "$pw_day" -gt 0 ] 2>/dev/null; then
			pw_age=$(( $(date +%s) / 86400 - pw_day ))
			pwage_html="<span class=\"num\">changed $pw_age day(s) ago</span>"
		else
			pwage_html='<span class="mut">unknown</span>'
		fi ;;
esac
# SSH posture, from the EFFECTIVE config (sshd -T resolves defaults and
# Match blocks; falls back to "?" rather than guessing from the file)
if rc-service sshd status >/dev/null 2>&1; then
	ssh_html='<span class="pill p-ok">enabled</span>'
	sshd_eff=$(timeout 3 sshd -T 2>/dev/null)
	ssh_root=$(printf '%s' "$sshd_eff" | awk '$1=="permitrootlogin"{print $2}')
	ssh_pass=$(printf '%s' "$sshd_eff" | awk '$1=="passwordauthentication"{print $2}')
	case "$ssh_root" in
		yes) sshroot_html='<span class="pill p-ok">enabled</span>' ;;
		without-password|prohibit-password) sshroot_html='<span class="pill p-ok">keys only</span>' ;;
		no) sshroot_html='<span class="pill p-off">disabled</span>' ;;
		*) sshroot_html='<span class="mut">?</span>' ;;
	esac
	case "$ssh_pass" in
		yes) sshpass_html='<span class="pill p-ok">enabled</span>' ;;
		no) sshpass_html='<span class="pill p-off">disabled (keys only)</span>' ;;
		*) sshpass_html='<span class="mut">?</span>' ;;
	esac
else
	ssh_html='<span class="pill p-off">disabled</span>'
	sshroot_html='<span class="mut">-</span>'
	sshpass_html='<span class="mut">-</span>'
fi
if rc-service mountnas-ttyd status >/dev/null 2>&1; then
	webterm_html='<span class="pill p-ok">enabled</span>'
else
	webterm_html='<span class="pill p-off">disabled</span>'
fi
pkgcount=$(apk info 2>/dev/null | wc -l | tr -d ' ')
: "${pkgcount:=?}"
# DMI/cpuinfo strings are hardware-authored free text — escape them like every
# other interpolated value (they were the only two unescaped interpolations)
cpu_model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null | esc)
[ -n "$cpu_model" ] || cpu_model="?"
hw_vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null | esc || true)
hw_product=$(cat /sys/class/dmi/id/product_name 2>/dev/null | esc || true)
hw="${hw_vendor:+$hw_vendor }${hw_product:-?}"
now_tz=$(date '+%Y-%m-%d %H:%M:%S %Z')

# ---- config-partition footprint (always-awake USB, metadata reads only) ----
ovl_kb=$(du -k "$CFG/$(hostname).apkovl.tar.gz" 2>/dev/null | cut -f1)
cache_kb=$(du -sk "$CFG/cache" 2>/dev/null | cut -f1)
ovl_sz=$([ -n "$ovl_kb" ] && hum_kb "$ovl_kb" || echo "-")
cache_sz=$([ -n "$cache_kb" ] && hum_kb "$cache_kb" || echo "-")

# ---- protection: backups on disk + snapraid parity age ----------------------
bk_html='<span class="mut">none on disk</span>'
if mountpoint -q "$DATA" 2>/dev/null; then
	bk_n=$(find "$DATA/backups" -maxdepth 1 -name 'mountnas-backup-*.img.gz' 2>/dev/null | wc -l | tr -d ' ')
	if [ "${bk_n:-0}" -gt 0 ] 2>/dev/null; then
		bk_new=$(ls -t "$DATA"/backups/mountnas-backup-*.img.gz 2>/dev/null | head -n1)
		bk_html="<span class=\"num\">$bk_n on disk &middot; newest $(date -r "$bk_new" '+%Y-%m-%d' 2>/dev/null)</span>"
	fi
fi
sr_html='<span class="mut">not configured</span>'
# Prefer the maintenance runner's verdict (nas snapraid): it knows WHY parity
# is stale — a gated sync must render as a warning with the reason, not as an
# unexplained age. Boxes that only run raw 'snapraid sync' have no state file
# and keep the content-file age fallback below.
sr_state=/mnt/nasdata/snapraid/state/last-run
sr_content=$(awk '$1=="content"{print $2; exit}' /etc/snapraid.conf 2>/dev/null)
if [ -n "$sr_content" ] && [ -f "$sr_state" ]; then
	sr_v=$(sed -n 's/^verdict=//p' "$sr_state" | esc)
	sr_d=$(sed -n 's/^date=//p' "$sr_state" | cut -d' ' -f1 | esc)
	case "$sr_v" in
		SYNCED|NOTHING) sr_html="<span class=\"pill p-ok\">maintained &middot; last run $sr_d</span>" ;;
		BLOCKED) sr_html="<span class=\"pill p-warn\">sync BLOCKED by the threshold gate &middot; nas snapraid status</span>" ;;
		*) sr_html="<span class=\"pill p-warn\">last run $sr_v $sr_d &middot; nas snapraid status</span>" ;;
	esac
elif [ -n "$sr_content" ]; then
	if [ -f "$sr_content" ]; then
		sr_age=$(( ( $(date +%s) - $(date -r "$sr_content" +%s 2>/dev/null || date +%s) ) / 86400 ))
		if [ "$sr_age" -ge 8 ]; then
			sr_html="<span class=\"pill p-warn\">synced $sr_age day(s) ago</span>"
		else
			sr_html="<span class=\"pill p-ok\">synced $sr_age day(s) ago</span>"
		fi
	else
		sr_html='<span class="pill p-warn">configured, never synced</span>'
	fi
fi

# ---- the SnapRAID card -----------------------------------------------------
# CHEAP BY CONTRACT: this renders every ~2 minutes, and NO snapraid command
# reads array state without touching the data disks ('status' reads the
# content files, 'diff' walks every file) — one call per render would keep
# spun-down disks awake forever. Everything here comes from snapraid.conf,
# /proc/mounts, df on mounted filesystems, and the maintenance runner's
# state file. The detail lives in 'nas snapraid status [--deep]'.
if grep -qE '^[[:space:]]*data[[:space:]]' /etc/snapraid.conf 2>/dev/null; then
	srt_rows=$(awk '$1!~/^#/ {
		if ($1=="data") printf "%s\tdata\t%s\n", $2, $3
		else if ($1 ~ /^([2-6]-|z-)?parity$/) { n=split($2,a,","); for(i=1;i<=n;i++) printf "%s\tparity\t%s\n", $1, a[i] }
	}' /etc/snapraid.conf 2>/dev/null | while IFS="$(printf '\t')" read -r srt_n srt_r srt_p; do
		srt_d=$srt_p; [ -d "$srt_d" ] || srt_d=$(dirname "$srt_p")
		srt_m='<span class="pill p-warn">MISSING</span>'; srt_s="-"
		srt_w=$srt_d
		while [ "$srt_w" != "/" ]; do
			if mountpoint -q "$srt_w" 2>/dev/null; then
				srt_m='<span class="pill p-ok">mounted</span>'
				srt_s=$(df -h "$srt_d" 2>/dev/null | awk 'NR==2{printf "%s / %s", $3, $2}')
				break
			fi
			srt_w=$(dirname "$srt_w")
		done
		printf '<tr><td class="mono">%s</td><td>%s</td><td class="mono">%s</td><td>%s</td><td class="num">%s</td></tr>\n' \
			"$(printf '%s' "$srt_n" | esc)" "$srt_r" "$(printf '%s' "$srt_p" | esc)" "$srt_m" "${srt_s:--}"
	done)
	# last run + schedule, from OUR state (never from snapraid itself)
	if [ -f "$sr_state" ]; then
		srt_when=$(sed -n 's/^date=//p' "$sr_state" | esc)
		# relative age next to the timestamp ("18 hours ago" beats mental math)
		srt_ago=""
		srt_ep=$(date -d "$srt_when" +%s 2>/dev/null)
		if [ -n "$srt_ep" ] 2>/dev/null; then
			srt_ago=$(awk -v s=$(( $(date +%s) - srt_ep )) 'BEGIN{
				if (s < 0) s = 0
				d = int(s/86400); h = int(s%86400/3600); m = int(s%3600/60)
				if (d > 0) printf " <span class=\"mut\">(%dd %dh ago)</span>", d, h
				else if (h > 0) printf " <span class=\"mut\">(%dh %dm ago)</span>", h, m
				else printf " <span class=\"mut\">(%dm ago)</span>", m }')
		fi
		srt_result="$(sed -n 's/^verdict=//p' "$sr_state" | esc) (+$(sed -n 's/^added=//p' "$sr_state" | esc) added, $(sed -n 's/^deleted=//p' "$sr_state" | esc) deleted, $(sed -n 's/^updated=//p' "$sr_state" | esc) changed &middot; scrub $(sed -n 's/^scrubbed=//p' "$sr_state" | esc))"
	else
		srt_when="never"; srt_ago=""
		srt_result='run it: <span class="mono">nas snapraid run</span>'
	fi
	srt_cron=$(crontab -l 2>/dev/null | grep -F '# mountnas-snapraid' | awk '{printf "%02d:%02d nightly", $2, $1}')
	[ -n "$srt_cron" ] || srt_cron='not scheduled — <span class="mono">nas snapraid schedule</span>'
	srt_thr=$(sed -n 's/^DEL_THRESHOLD=\([0-9]*\).*/\1/p' /etc/mountnas/snapraid-maint.conf 2>/dev/null | tail -n1)
	srt_thr2=$(sed -n 's/^UPD_THRESHOLD=\([0-9]*\).*/\1/p' /etc/mountnas/snapraid-maint.conf 2>/dev/null | tail -n1)
	snapraid_html="<div style=\"overflow-x:auto\"><table><thead><tr><th>Name</th><th>Role</th><th>Path</th><th>State</th><th>Used</th></tr></thead><tbody>$srt_rows</tbody></table></div>
      <div class=\"srmeta srmeta2\">
        <div><h3>Maintenance</h3><div class=\"num\">
          $srt_cron<br>
          Last run:<br>
          $srt_when$srt_ago<br>
          $srt_result</div></div>
        <div><h3>Maintenance safety</h3><div class=\"num\">
          Abort conditions:<br>
          &gt;${srt_thr:-100} files deleted<br>
          &gt;${srt_thr2:-200} files changed</div></div>
      </div>"
else
	snapraid_html="<div class=\"mut\">SnapRAID is not configured — no parity protection. <span class=\"mono\">nas snapraid status</span> shows the setup steps; the <a href=\"guide.html\">user guide</a> has the walkthrough.</div>"
fi

# ---- services (core from status --json; off-by-default probed here) --------
services=$(printf '%s' "$sj" | jq -r '
	[.services[]? |
	  if .running then "<span class=\"pill p-ok\"><i></i>\(.name | @html)</span>"
	  else "<span class=\"pill p-off\"><i></i>\(.name | @html)</span>" end
	] | join(" ")')
[ -n "$services" ] || services='<span class="mut">no service data</span>'
# a stopped optional service is a neutral "off", never a warning — exactly why
# these cannot join the cmd_status service loop, which warns on stopped entries
for s in tailscale zerotier-one nut-upsd nut-upsmon; do
	if rc-service "$s" status >/dev/null 2>&1; then
		services="$services <span class=\"pill p-ok\"><i></i>$s</span>"
	else
		services="$services <span class=\"pill p-off\"><i></i>$s</span>"
	fi
done
# firewall (ufw, shipped disabled): active = its iptables chains are loaded
# (same no-python probe as nas status). When active, the full ruleset renders
# into a collapsible card via 'ufw status verbose' — state, default policies,
# logging, every rule; spawning python for that is fine at render time (root,
# every ~2 min) and never happens at request time. Chain/rule reads touch no
# disk, so the no-spin-up contract holds.
if iptables -nL ufw-user-input >/dev/null 2>&1; then
	services="$services <span class=\"pill p-ok\"><i></i>ufw</span>"
	fw_n=$(cat /etc/ufw/user.rules /etc/ufw/user6.rules 2>/dev/null | grep -c '^### tuple')
	fw_out=$(timeout 10 ufw status verbose 2>/dev/null | esc)
	[ -n "$fw_out" ] || fw_out="(ufw active — no report; run 'ufw status verbose' over SSH)"
	fw_sum="active &middot; $fw_n rule(s)"
	fw_prot="<span class=\"pill p-ok\">active &middot; $fw_n rule(s)</span>"
else
	services="$services <span class=\"pill p-off\"><i></i>ufw</span>"
	fw_sum="disabled &mdash; all ports open (shipped default)"
	fw_prot='<span class="pill p-off">off &mdash; LAN-open (shipped default)</span>'
	fw_out="The firewall is disabled: the box accepts every connection (the shipped
default — MountNAS trusts its LAN and your router's perimeter).

To enable it, allow your services FIRST, then switch on and save:
  ufw allow SSH
  ufw allow CIFS          # samba;  'ufw app list' shows all profiles (NFS, ...)
  ufw allow 8080/tcp      # this dashboard (and 22222 for the web terminal)
  ufw enable
  nas commit
Docker-published ports bypass ufw — Docker programs its own iptables rules."
fi
fw_card="<details class=\"card\"><summary>Firewall (ufw) <span class=\"mut\">($fw_sum)</span></summary><pre class=\"log\">$fw_out</pre></details>"

wg_ifs=$(wg show interfaces 2>/dev/null | tr '\n' ' ')
if [ -n "${wg_ifs% }" ]; then
	services="$services <span class=\"pill p-ok\"><i></i>wireguard (${wg_ifs% })</span>"
else
	services="$services <span class=\"pill p-off\"><i></i>wireguard</span>"
fi
# context lines under the pills: VPN addresses + UPS state, only when up
svc_extra=""
if rc-service tailscale status >/dev/null 2>&1; then
	ts_ip=$(tailscale ip -4 2>/dev/null | head -n1)
	[ -n "$ts_ip" ] && svc_extra="$svc_extra<div class=\"mut svcx\">tailscale: <span class=\"num\">$ts_ip</span></div>"
fi
if rc-service zerotier-one status >/dev/null 2>&1; then
	zt=$(zerotier-cli listnetworks 2>/dev/null | awk 'NR>1 && $NF ~ /\// {printf "%s%s", (c++?", ":""), $NF}')
	[ -n "$zt" ] && svc_extra="$svc_extra<div class=\"mut svcx\">zerotier: <span class=\"num\">$(printf '%s' "$zt" | esc)</span></div>"
fi
if rc-service nut-upsd status >/dev/null 2>&1; then
	ups_name=$(upsc -l 2>/dev/null | head -n1)
	if [ -n "$ups_name" ]; then
		ups_stat=$(upsc "$ups_name" ups.status 2>/dev/null)
		ups_chg=$(upsc "$ups_name" battery.charge 2>/dev/null)
		ups_rt=$(upsc "$ups_name" battery.runtime 2>/dev/null)
		# some drivers omit battery.runtime or report N/A — never feed that
		# into arithmetic (ash errors and the raw string leaks into the page)
		case "$ups_rt" in ''|*[!0-9]*) ups_rt="" ;; *) ups_rt="$((ups_rt / 60)) min" ;; esac
		case "$ups_stat" in
			OL*) ups_pill="<span class=\"pill p-ok\">on line</span>" ;;
			OB*) ups_pill="<span class=\"pill p-fail\">ON BATTERY</span>" ;;
			*)   ups_pill="<span class=\"pill p-off\">$(printf '%s' "${ups_stat:-?}" | esc)</span>" ;;
		esac
		svc_extra="$svc_extra<div class=\"mut svcx\">UPS $(printf '%s' "$ups_name" | esc): $ups_pill <span class=\"num\">${ups_chg:+$ups_chg%}${ups_rt:+ &middot; $ups_rt}</span></div>"
	fi
fi

# ---- docker containers (guarded on the daemon) -------------------------------
# ONE time-bounded `docker ps -a` builds the containers card (a wedged
# dockerd — e.g. the data disk died underneath it — would otherwise block
# this renderer forever), plus ONE bounded `docker stats --no-stream` for
# per-container RAM (a ~1 s cgroup sample; fine once per 2-minute render).
# Deliberately NOT requested: {{.Size}} — docker walks each container's rw
# layer to compute it, the one genuinely expensive field, and it grows with
# container size. Disk use stays a CLI question (docker system df).
# a deliberately disabled docker (DATA_SERVICES= in /etc/conf.d/mountnas)
# must not read as "held waiting for the disk" — same override-awareness as
# nas status. The '=' sentinel separates an explicitly empty list (no data
# services at all) from a conf.d whose sourcing died, which falls back to the
# built-in set; '-' not ':-' so an empty list stays empty. Kept in sync with
# _data_services() in the nas CLI (separate files, no shared shell library).
ds_on=$(unset DATA_SERVICES; . /etc/conf.d/mountnas 2>/dev/null || :; printf '=%s' "${DATA_SERVICES-docker samba nfs}")
case "$ds_on" in
	=*) ds_on=${ds_on#=} ;;
	*)  ds_on="docker samba nfs" ;;
esac
case " $ds_on " in
	*" docker "*) docker_html='<span class="mut">docker not running (held until the data disk is up)</span>' ;;
	*) docker_html='<span class="mut">docker disabled via /etc/conf.d/mountnas</span>' ;;
esac
docker_card=""
if rc-service docker status >/dev/null 2>&1; then
	d_ps=$(timeout 10 docker ps -a --no-trunc=false --format \
		'{{.Names}}\t{{.ID}}\t{{.State}}\t{{.Status}}\t{{.Image}}\t{{.Ports}}\t{{.RunningFor}}' \
		2>/dev/null | esc)
	if [ -n "$d_ps" ]; then
		d_run=$(printf '%s\n' "$d_ps" | awk -F'\t' '$3=="running"' | grep -c .)
		d_pau=$(printf '%s\n' "$d_ps" | awk -F'\t' '$3=="paused"' | grep -c .)
		d_res=$(printf '%s\n' "$d_ps" | awk -F'\t' '$3=="restarting"' | grep -c .)
		d_all=$(printf '%s\n' "$d_ps" | grep -c .)
		d_oth=$((d_all - d_run - d_pau - d_res))
		# restarting = an ACTIVE failure (crash loop) — its own amber pill,
		# shown only when nonzero; it must never hide inside "stopped"
		d_res_pill=""
		[ "$d_res" -gt 0 ] && d_res_pill=" <span class=\"pill p-warn\"><i></i>$d_res restarting</span>"
		# per-container RAM in one bounded sample; joined to the rows by name
		d_mem=$(timeout 10 docker stats --no-stream --format '{{.Name}}\t{{.MemUsage}}' 2>/dev/null | esc)
		d_rows=$( { printf '%s\n' "$d_mem"; echo "MEMEND"; printf '%s\n' "$d_ps"; } | awk -F'\t' '
			!body { if ($0 == "MEMEND") { body=1 } else if (NF >= 2) { mem[$1]=$2 } ; next }
			{
			state=$3; cls="p-off"
			if (state == "running") cls="p-ok"
			else if (state == "paused" || state == "restarting") cls="p-warn"
			else if ($4 ~ /^Exited \([1-9]/) cls="p-fail"
			ports=$6; if (ports == "") ports="<span class=\"mut\">&mdash;</span>"
			m=mem[$1]; sub(/ \/.*/, "", m)   # "82MiB / 3.8GiB" -> used part
			if (m == "") m="<span class=\"mut\">&mdash;</span>"
			printf "<tr><td><b>%s</b><br><span class=\"mono mut\" style=\"font-size:11px\">%s</span></td>", $1, $2
			printf "<td><span class=\"pill %s\"><i></i>%s</span><br><span class=\"mut\" style=\"font-size:11.5px\">%s</span></td>", cls, state, $4
			printf "<td class=\"mono\" style=\"font-size:12.5px\">%s</td><td class=\"mono\" style=\"font-size:12px\">%s</td><td class=\"num\">%s</td><td class=\"num mut\">%s</td></tr>\n", $5, ports, m, $7
		}')
		# ONE collapsible card: the state pills live in the summary line, so
		# the counts are always visible and one click opens the table
		docker_card="<details class=\"card\"><summary>Docker <span class=\"svc\" style=\"display:inline-flex\"><span class=\"pill p-ok\"><i></i>$d_run running</span> <span class=\"pill p-warn\"><i></i>$d_pau paused</span>$d_res_pill <span class=\"pill p-off\"><i></i>$d_oth stopped</span></span> <span class=\"mut\">($d_all container(s) &mdash; click for detail)</span></summary><div style=\"overflow-x:auto;border-top:1px solid var(--line)\"><table><thead><tr><th>Container</th><th>State</th><th>Image</th><th>Ports</th><th>RAM</th><th>Created</th></tr></thead><tbody>$d_rows</tbody></table></div></details>"
	else
		docker_html='<span class="mut">daemon up &middot; unresponsive or no containers yet</span>'
	fi
fi
# daemon down / disabled / no containers: a plain card carrying the reason
[ -n "$docker_card" ] || docker_card="<div class=\"card\" style=\"margin-bottom:14px\"><h2>Docker</h2>$docker_html</div>"

# ---- network interfaces (pure /sys reads) ------------------------------------
net_rows=""
for n in /sys/class/net/*; do
	i=${n##*/}
	[ "$i" = lo ] && continue
	oper=$(cat "$n/operstate" 2>/dev/null)
	rx=$(cat "$n/statistics/rx_bytes" 2>/dev/null || echo 0)
	tx=$(cat "$n/statistics/tx_bytes" 2>/dev/null || echo 0)
	spd=$(cat "$n/speed" 2>/dev/null)
	case "$spd" in ''|*[!0-9]*) spd="" ;; esac
	rx_h=$(hum_kb $((rx / 1024))); tx_h=$(hum_kb $((tx / 1024)))
	if [ "$oper" = up ]; then op="<span class=\"pill p-ok\"><i></i>up</span>"
	else op="<span class=\"pill p-off\"><i></i>${oper:-down}</span>"; fi
	net_rows="$net_rows<dt class=\"mono\">$i</dt><dd>$op ${spd:+<span class=\"num\">$spd Mb/s</span> &middot;} <span class=\"num mut\">&darr;$rx_h &uarr;$tx_h</span></dd>"
done
[ -n "$net_rows" ] || net_rows='<dt>-</dt><dd class="mut">no interfaces</dd>'
# the card has room: the three answers people otherwise SSH in for
gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
[ -n "$gw" ] && net_rows="$net_rows<dt>Gateway</dt><dd class=\"num\">$gw</dd>"
dns=$(awk '/^nameserver/{printf "%s%s", s, $2; s=" &middot; "}' /etc/resolv.conf 2>/dev/null)
[ -n "$dns" ] && net_rows="$net_rows<dt>DNS</dt><dd class=\"num\">$dns</dd>"
net_rows="$net_rows<dt>mDNS name</dt><dd class=\"num\">$(hostname).local</dd>"

# every check, verdict-first: fails, then warnings, then the passing set —
# so the header pill's "Warnings" always has its reason one click away (#checks)
checks=$(printf '%s' "$sj" | jq -r '
	([.fail_lines[]? | "<li class=\"c-fail\">\(@html)</li>"] +
	 [.warn_lines[]? | "<li class=\"c-warn\">\(@html)</li>"] +
	 [.ok_lines[]?   | "<li class=\"c-ok\">\(@html)</li>"]) | join("\n")')
if [ -z "$checks" ]; then
	if [ "$state" = ok ]; then checks='<li class="c-ok">All checks passed</li>'
	else checks='<li class="mut">no check data</li>'; fi
fi

# browser terminal (mountnas-ttyd): linked from the header AND the footer by
# the box's first IP — the one address guaranteed reachable from any client
# that can see this page (mDNS names do not resolve everywhere). The header
# element always shows whether the service is running; it is only a link when
# there is something to click through to.
ttyd_link=""
if rc-service mountnas-ttyd status >/dev/null 2>&1; then
	ttyd_port=$(sed -n 's/^PORT=//p' /etc/conf.d/mountnas-ttyd 2>/dev/null | head -n1)
	: "${ttyd_port:=22222}"
	# ips[] entries carry their CIDR suffix (10.0.2.15/24) — strip it or the
	# href is malformed (http://10.0.2.15/24:22222/, a dead link)
	ttyd_ip=$(printf '%s' "$sj" | jq -r '.ips[0] // empty')
	ttyd_ip=${ttyd_ip%%/*}
	if [ -n "$ttyd_ip" ]; then
		ttyd_link="<a href=\"http://$ttyd_ip:$ttyd_port/\">Web terminal</a>"
		ttyd_hdr="<a class=\"termlink\" href=\"http://$ttyd_ip:$ttyd_port/\"><span class=\"pill p-ok\"><i></i>Web terminal</span></a>"
	else
		ttyd_hdr="<span class=\"pill p-ok\"><i></i>Web terminal</span>"
	fi
else
	ttyd_hdr="<a class=\"termlink\" href=\"guide.html#ttyd\" title=\"how to enable it\"><span class=\"pill p-off\"><i></i>Web terminal off</span></a>"
fi

recent_ops=$(tail -n 4 "$CFG/mountnas-ops.log" 2>/dev/null | esc \
	| awk -F'\t' '{ ts=substr($1,1,19); gsub(/T/," ",ts);
		printf "<li><span class=\"num mut\">%s</span> <b>%s</b> <span class=\"mut\">%s</span></li>\n", ts, $2, $4 }')
[ -n "$recent_ops" ] || recent_ops='<li class="mut">none yet — commits, backups and upgrades land here</li>'

# ---- SMART overall health, STANDBY-SAFE and cached (15 min) ------------------
SMART_CACHE=/run/mountnas/websmart
if [ ! -f "$SMART_CACHE" ] || [ "$(( $(date +%s) - $(date -r "$SMART_CACHE" +%s 2>/dev/null || echo 0) ))" -ge 900 ]; then
	printf '%s' "$dj" \
	| jq -r '.disks[]? | .name' \
	| while IFS= read -r d; do
		[ -n "$d" ] || continue
		# time-bounded like docker/ufw above: a disk with a hung ioctl must
		# not wedge the renderer (the exact failure the header rules out)
		sm=$(timeout 10 smartctl -n standby -H "/dev/$d" 2>/dev/null)
		case "$sm" in
			*PASSED*|*"SMART Health Status: OK"*) v=PASSED ;;
			*FAILED*)                             v=FAILED ;;
			*STANDBY*|*standby*)                  v=standby ;;
			*)                                    v=n/a ;;
		esac
		printf '%s\t%s\n' "$d" "$v"
	done > "$SMART_CACHE.new" && mv "$SMART_CACHE.new" "$SMART_CACHE"
fi
smart_map=$(awk -F'\t' '{printf "{\"k\":\"%s\",\"v\":\"%s\"}\n", $1, $2}' "$SMART_CACHE" 2>/dev/null \
	| jq -s 'map({(.k): .v}) | add // {}')
[ -n "$smart_map" ] || smart_map='{}'

# ---- disk power state (hdparm -C is an ioctl; never wakes a drive) -----------
power_map=$(printf '%s' "$dj" \
	| jq -r '.disks[]? | .name' \
	| while IFS= read -r d; do
		[ -n "$d" ] || continue
		p=$(timeout 10 hdparm -C "/dev/$d" 2>/dev/null | awk -F': *' '/drive state/{print $2}')
		case "$p" in
			*active*|*idle*) v=active ;;
			*standby*|*sleeping*) v=standby ;;
			*) v=- ;;
		esac
		printf '{"k":"%s","v":"%s"}\n' "$d" "$v"
	done | jq -s 'map({(.k): .v}) | add // {}')
[ -n "$power_map" ] || power_map='{}'

# every partition that carries a filesystem is listed (mounted ones with a
# used-fill bar + free space); junk devices (floppy/cdrom/loop) filtered out
disk_rows=$(printf '%s' "$dj" | jq -r --argjson smart "$smart_map" --argjson power "$power_map" '
	def hum: if . == null then "?"
		elif . >= 1099511627776 then "\(. / 1099511627776 * 10 | round / 10) TB"
		elif . >= 1073741824 then "\(. / 1073741824 * 10 | round / 10) GB"
		else "\(. / 1048576 | floor) MB" end;
	def bar: (if . >= 90 then "b-fail" elif . >= 80 then "b-warn" else "" end) as $c |
		"<span class=\"bar \($c)\"><i style=\"width:\(.)%\"></i></span>";
	.disks[]? |
	"<tr><td class=\"mono\">\(.name | @html)\(if .boot_usb then " <span class=\"pill p-boot\">boot USB</span>" else "" end)</td>" +
	"<td>\((.model // .vendor // "?") | @html)</td>" +
	"<td class=\"num\">\(.size | hum)</td>" +
	"<td>\(if .rotational then "HDD" else "SSD" end)</td>" +
	"<td>\( ($power[.name] // "-") as $pv |
		if $pv == "active" then "<span class=\"pill p-ok\">active</span>"
		elif $pv == "standby" then "<span class=\"pill p-off\">standby</span>"
		else "<span class=\"mut\">-</span>" end)</td>" +
	"<td class=\"num\">\((.temp // "-") | @html)</td>" +
	"<td>\( ($smart[.name] // "n/a") as $sv |
		if $sv == "PASSED" then "<span class=\"pill p-ok\">PASSED</span>"
		elif $sv == "FAILED" then "<span class=\"pill p-fail\">FAILED</span>"
		elif $sv == "standby" then "<span class=\"pill p-off\">standby</span>"
		else "<span class=\"mut\">n/a</span>" end)</td>" +
	"<td>\([ .partitions[]? | select(.fstype != null) |
		if .mountpoint != null then
			((if (.size // 0) > 0 and .fsavail != null then (100 - (.fsavail * 100 / .size) | floor) else null end)) as $pct |
			"<span class=\"mnt\"><b>\((.label // .name) | @html)</b> &rarr; \(.mountpoint | @html) \(if $pct != null then ($pct | bar) else "" end) <span class=\"mut\">&middot; \(.fstype | @html) &middot; \(.fsavail | hum) free</span></span>"
		else
			"<span class=\"mnt mut\"><b>\((.label // .name) | @html)</b> &middot; \(.fstype | @html) &middot; not mounted</span>"
		end
	  ] | if length == 0 then "<span class=\"mut\">no filesystem</span>" else join("<br>") end)</td></tr>"')
[ -n "$disk_rows" ] || disk_rows='<tr><td colspan="8" class="mut">no disk data</td></tr>'

# mergerfs pools are fuse mounts (invisible to lsblk) — appended as rows.
# /proc/mounts octal-escapes spaces as \040: decode with %b or df misses the
# path and the pool silently vanishes from the table.
pool_rows=$(awk '$3=="fuse.mergerfs"{print $2}' /proc/mounts 2>/dev/null \
	| while IFS= read -r mp_raw; do
		mp=$(printf '%b' "$mp_raw")
		df -kP "$mp" 2>/dev/null | awk -v mp="$mp" 'NR==2 {
			pct = int($3 * 100 / $2);
			cls = (pct >= 90) ? "b-fail" : (pct >= 80) ? "b-warn" : "";
			printf "<tr><td class=\"mono\">pool</td><td>mergerfs</td><td class=\"num\">%.1f GB</td><td>POOL</td><td><span class=\"mut\">-</span></td><td class=\"num\">-</td><td><span class=\"mut\">-</span></td><td><span class=\"mnt\"><b>pool</b> &rarr; %s <span class=\"bar %s\"><i style=\"width:%d%%\"></i></span> <span class=\"mut\">&middot; fuse.mergerfs &middot; %.1f GB free</span></span></td></tr>\n",
				$2/1048576, mp, cls, pct, $4/1048576 }'
	done)
disk_rows="$disk_rows$pool_rows"

# ---- hardware inventory: USB tree, PCI devices, memory modules ---------------
# All three read sysfs/SMBIOS tables only (microseconds, never a disk touch).
usb_tree=$(lsusb -tv 2>/dev/null | esc)
[ -n "$usb_tree" ] || usb_tree="(no USB devices visible)"
pci_list=$(lspci 2>/dev/null | esc)
[ -n "$pci_list" ] || pci_list="(no PCI devices visible)"
dimms=$(dmidecode -t 17 2>/dev/null | awk -F': ' '
	function flush() {
		if (size != "" && size !~ /No Module/)
			printf "%-16s %-10s %-8s %-14s %s\n", loc, size, type, spd, man
	}
	/^Handle /       { flush(); loc=size=type=spd=man="" }
	/^\tSize: /      { size=$2 }
	/^\tLocator: /   { loc=$2 }
	/^\tType: /      { type=$2 }
	/^\tSpeed: /     { spd=$2 }
	/^\tManufacturer: / { man=$2 }
	END { flush() }' | esc)
[ -n "$dimms" ] || dimms="(no DMI memory-module data)"

# ---- release-base diff + cron + unsaved list + syslog tail -------------------
wb=$(find /media -maxdepth 2 -name world.base 2>/dev/null | head -n1)
if [ -n "$wb" ] && [ -s "$wb" ]; then
	extras=$(awk 'NR==FNR{a[$1];next} !($1 in a)' "$wb" /etc/apk/world 2>/dev/null \
		| esc | awk '{printf "<code>%s</code> ", $1}')
	[ -n "$extras" ] || extras='<span class="mut">none — stock image</span>'
else
	extras='<span class="mut">(release package list not readable)</span>'
fi
cron_html=$(crontab -l 2>/dev/null | grep -vE '^[[:space:]]*(#|$)' | head -n 12 | esc)
[ -n "$cron_html" ] || cron_html="(no scheduled jobs — snapraid sync and the health digest go here)"
# run the /etc-walking lbu status ONLY when the count (already computed by
# status --json above) says there is something to list — in the committed
# steady state this saves a full lbu walk every render
if [ "${unsaved:-0}" -gt 0 ] 2>/dev/null; then
	unsaved_list=$(lbu status 2>/dev/null | head -n 40 | esc)
	[ -n "$unsaved_list" ] || unsaved_list="(nothing — all changes are committed)"
else
	unsaved_list="(nothing — all changes are committed)"
fi
syslog_file=$(sed -n 's/.*-O \([^ "]*\).*/\1/p' /etc/conf.d/syslog 2>/dev/null | head -n1)
[ -n "$syslog_file" ] && [ -f "$syslog_file" ] || syslog_file=/var/log/messages
syslog_html=$(tail -n 100 "$syslog_file" 2>/dev/null | esc)
[ -n "$syslog_html" ] || syslog_html="(no syslog entries yet)"

case "$datastate" in
	ok) data_cls=ok; data_word="mounted" ;;
	fresh) data_cls=warn; data_word="not configured yet" ;;
	*) data_cls=fail; data_word="$datastate" ;;
esac
if [ "${unsaved:-0}" -gt 0 ] 2>/dev/null; then
	unsaved_html="<span class=\"pill p-warn\">$unsaved unsaved &mdash; nas commit</span>"
else
	unsaved_html="<span class=\"pill p-ok\">none</span>"
fi

# ---- stylesheet --------------------------------------------------------------
css=$(cat <<'CSSEOF'
:root{--bg:#eef2f6;--card:#fff;--ink:#16222e;--mut:#5c6b7a;--line:#d9e1e9;
--navy:#043b62;--acc:#1273b8;--ok:#148a46;--okbg:#e2f3e9;--warn:#8a6100;
--warnbg:#f7edd0;--fail:#c22d23;--failbg:#fae4e2;--off:#5c6b7a;--offbg:#e7ecf1}
@media(prefers-color-scheme:dark){:root{--bg:#0d151d;--card:#152230;--ink:#e4edf5;
--mut:#8ea1b3;--line:#233648;--navy:#043b62;--acc:#4aa3e0;--ok:#3cc776;--okbg:#12301e;
--warn:#e3ac3c;--warnbg:#2e2513;--fail:#ff6f64;--failbg:#341713;--off:#8ea1b3;--offbg:#1b2a3a}}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
.mono{font-family:ui-monospace,Menlo,Consolas,monospace}
.num{font-variant-numeric:tabular-nums;white-space:nowrap}
.mut{color:var(--mut)}
header{background:var(--navy);color:#fff;padding:14px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
header img{width:44px;height:44px;border-radius:9px}
header h1{font-size:20px;line-height:1.2}
header .sub{color:#a8c4dc;font-size:12.5px}
header .spacer{flex:1}
header .upd{color:#a8c4dc;font-size:11.5px;text-align:right}
.wrap{max-width:1080px;margin:0 auto;padding:18px 20px 40px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px;margin-bottom:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.card h2{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--mut);margin-bottom:10px}
dl{display:grid;grid-template-columns:auto 1fr;gap:5px 14px;font-size:13.5px}
dt{color:var(--mut);white-space:nowrap}dd{text-align:right;overflow-wrap:anywhere}
.pill{display:inline-flex;align-items:center;gap:6px;padding:2px 10px;border-radius:14px;font-size:12px;font-weight:600}
.pill i{width:7px;height:7px;border-radius:50%;background:currentColor;display:inline-block}
.p-ok{color:var(--ok);background:var(--okbg)}.p-warn{color:var(--warn);background:var(--warnbg)}
.p-fail{color:var(--fail);background:var(--failbg)}.p-off{color:var(--off);background:var(--offbg)}
.p-boot{color:var(--acc);background:var(--offbg);font-size:10.5px}
.svc{display:flex;flex-wrap:wrap;gap:7px}
.svcx{font-size:12.5px;margin-top:7px}
ul.checks,ul.ops{list-style:none;font-size:13px;margin:0;padding:0}
ul.checks{max-height:340px;overflow-y:auto}
ul.checks li{padding:3px 0 3px 22px;position:relative}
ul.checks li::before{position:absolute;left:2px;top:3px;font-weight:700}
.c-ok::before{content:"\2713";color:var(--ok)}
.c-warn::before{content:"\26A0";color:var(--warn)}
.c-fail::before{content:"\2715";color:var(--fail)}
.c-off::before{content:"\2013";color:var(--off)}
.c-fail{color:var(--fail);font-weight:600}.c-warn{color:var(--warn)}
ul.ops li{padding:4px 0;border-bottom:1px dashed var(--line)}
ul.ops li:last-child{border-bottom:none}
.bar{display:inline-block;width:64px;height:6px;background:var(--offbg);border-radius:3px;overflow:hidden;vertical-align:middle}
.bar i{display:block;height:100%;background:var(--ok)}
.bar.b-warn i{background:var(--warn)}.bar.b-fail i{background:var(--fail)}
.srmeta{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;margin-top:12px}
.srmeta2{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));max-width:760px}
.srmeta .num{line-height:1.7}
.srmeta>div{background:var(--offbg);border:1px solid var(--line);border-radius:8px;padding:9px 12px;min-width:0}
.srmeta h3{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin-bottom:4px}
.srmeta .num{font-size:13px;overflow-wrap:anywhere}
.tablecard{padding:0;overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);text-align:left;padding:11px 14px;border-bottom:1px solid var(--line)}
td{padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:none}
.mnt{display:inline-block}
pre.log{background:var(--card);padding:12px 16px;overflow-x:auto;
font:12px/1.55 ui-monospace,Menlo,Consolas,monospace;color:var(--ink);
max-height:60vh;overflow-y:auto;white-space:pre-wrap;word-break:break-word;
border-top:1px solid var(--line)}
details.card{padding:0;margin-bottom:14px}
details.card summary{cursor:pointer;padding:12px 16px;font-size:11px;
letter-spacing:.09em;text-transform:uppercase;color:var(--mut);font-weight:600;
list-style:none;display:flex;align-items:center;gap:8px}
details.card summary::before{content:"\25B8";font-size:10px;transition:transform .12s}
details.card[open] summary::before{transform:rotate(90deg)}
details.card summary .mut{text-transform:none;letter-spacing:0;font-weight:400}
.pkglist code{background:var(--offbg);border-radius:4px;padding:1px 6px;font-size:12px;
display:inline-block;margin:2px 2px}
.termlink{text-decoration:none}
footer{max-width:1080px;margin:0 auto;padding:0 20px 30px;color:var(--mut);font-size:12.5px;display:flex;gap:18px;flex-wrap:wrap}
footer a{color:var(--acc);text-decoration:none}
footer a:hover{text-decoration:underline}
CSSEOF
)

